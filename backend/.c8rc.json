{
  "all": true,
  "extension": [".ts", ".js", ".mjs"],
  "include": [
    "app/**",
    "start/**",
    "config/**",
    "providers/**",
    "database/**",
    "scripts/**",
    "bin/**",
    "adonisrc.ts",
    "ace.js"
  ],
  "exclude": ["**/*.d.ts"],
  "exclude-after-remap": true,
  "reporter": ["text", "html", "json-summary", "json", "lcov"],
  "reports-dir": "coverage",
  "check-coverage": true,
  "lines": 94,
  "statements": 94,
  "branches": 95,
  "functions": 95
}
